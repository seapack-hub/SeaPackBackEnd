<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.seaPack.mapper.market.IndexSpotMapper">

    <resultMap id="BaseMap" type="org.seaPack.model.market.IndexSpot">
        <id property="indexCode" column="index_code"/>
        <result property="indexName" column="index_name"/>
        <result property="latestPrice" column="latest_price"/>
        <result property="changePct" column="change_pct"/>
        <result property="changeAmt" column="change_amt"/>
        <result property="openPrice" column="open_price"/>
        <result property="highPrice" column="high_price"/>
        <result property="lowPrice" column="low_price"/>
        <result property="prevClose" column="prev_close"/>
        <result property="volume" column="volume"/>
        <result property="turnover" column="turnover"/>
        <result property="tradeDate" column="trade_date"/>
        <result property="sortOrder" column="sort_order"/>
    </resultMap>

    <sql id="BaseColumns">
        index_code, index_name, latest_price, change_pct, change_amt,
        open_price, high_price, low_price, prev_close,
        volume, turnover, trade_date, sort_order
    </sql>

    <select id="selectAll" resultMap="BaseMap">
        SELECT <include refid="BaseColumns"/>
        FROM index_spot
        ORDER BY sort_order ASC, index_code ASC
    </select>

</mapper>
